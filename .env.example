APP_NAME="Adscale Zen"
# Use 'production' for live uses
APP_ENV=local
# Set to true for debugging
APP_DEBUG=true
# Application key (generate with php artisan key:generate)
APP_KEY=
APP_URL=https://crm.adscalezen.online
NGROK_URL=https://crm.adscalezen.online/
FORCE_HTTPS=true

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=whatsjet
DB_USERNAME=root
DB_PASSWORD=

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="support@adscalezen.online"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_FROM_ADD="support@adscalezen.online"

# Google OAuth Social Login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/login/google/callback"
